+def test_ttml_alternate_lead_and_explicit_adlib():
+    ttml = """<tt xmlns:ttm="http://www.w3.org/ns/ttml#metadata">
+    <body><p begin="1s" end="3s" ttm:agent="v2">
+    <span begin="1s" end="2s">Lead</span>
+    <span ttm:role="x-bg"><span begin="1.4s" end="1.7s">(hey)</span></span>
+    </p></body></tt>"""
+    lead, bg = lyrics.parse_ttml(ttml)
+    assert lead["text"] == "Lead" and not lead["is_bg"]
+    assert bg["is_bg"] and bg["t"] == 1.4 and bg["end"] == 1.7
+    assert bg["words"] == [{"text": "hey", "start": 1.4, "end": 1.7}]
+
+
+def test_adlib_alignment_rejects_same_length_different_words():
+    line = {"text": "sing (hey)", "t": 1, "words": [
+        {"text": "sing", "start": 1, "end": 2},
+        {"text": "bye", "start": 2, "end": 3},
+    ]}
+    assert lyrics._normalize_lines([line]) == [{**line, "words": [], "is_bg": False}]
+
+
+def test_adlib_without_timing_does_not_borrow_lead_window():
+    lead, bg = lyrics._normalize_lines([{"text": "sing (hey)", "t": 1, "end": 3}])
+    assert lead["t"] == 1 and lead["end"] == 3
+    assert bg["is_bg"] and bg["t"] is None and bg["end"] is None
