+def test_inline_adlibs_keep_following_lead_and_provider_timing():
+    tokens = ["feel", "it", "feel", "it", "yeah", "woo"]
+    original = [{"text": word, "start": idx, "end": idx + .5}
+                for idx, word in enumerate(tokens)]
+    lead, echo, tag = lyrics._normalize_lines([{
+        "t": 0, "end": 6, "text": "feel it (feel it), yeah (woo)", "words": original
+    }])
+    assert lead["text"] == "feel it, yeah"
+    assert lead["words"] == [original[0], original[1], original[4]]
+    assert echo["text"] == "Feel it"
+    assert echo["t"] == 2
+    assert echo["words"] == original[2:4]
+    assert tag["t"] == 5
+    assert tag["words"] == original[5:]
