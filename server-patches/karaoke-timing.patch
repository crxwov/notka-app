+def test_ttml_adjacent_syllables_and_overlapping_background():
+    ttml = """<tt xmlns:ttm="http://www.w3.org/ns/ttml#metadata">
+      <body><p begin="2.9s" end="5s"><span begin="2.9s" end="3.2s">So</span>
+      <span begin="3.8s" end="4s">rea</span><span begin="4s" end="4.4s">dy</span><span ttm:role="x-bg"><span begin="3.5s" end="3.8s">(hey)</span></span></p></body>
+      </tt>"""
+    lead, bg = lyrics.parse_ttml(ttml)
+    assert lead["text"] == "So ready"
+    assert lead["words"][1] == {"text": "ready", "start": 3.8, "end": 4.4}
+    assert bg["is_bg"]
+    assert bg["words"] == [{"text": "hey", "start": 3.5, "end": 3.8}]
+    assert bg["t"] == 3.5
+
+
+def test_exact_video_richsync_precedes_metadata_match(tmp_path, monkeypatch):
+    monkeypatch.setattr(lyrics, "_CACHE_DIR", tmp_path)
+    exact_line = {"t": 1, "text": "hello", "words": [{"text": "hello", "start": 1}]}
+
+    async def exact(video_id, *args):
+        assert video_id == "official"
+        return {"lines": [exact_line], "syncType": "word", "source": "unison"}
+
+    async def metadata(*args):
+        pytest.fail("Metadata fallback ran despite exact-video richsync")
+
+    monkeypatch.setattr(lyrics, "_from_unison", exact)
+    monkeypatch.setattr(lyrics, "_from_lrclib", metadata)
+    result = asyncio.run(lyrics.find_lyrics("Hello", "Artist", 120, video_id="official"))
+    assert result["source"] == "unison"
+    assert lyrics._cache_path("Hello", "Artist", 120, "official").exists()
+    assert not lyrics._cache_path("Hello", "Artist", 120, "other").exists()
