+    # Stream a progressive YouTube URL immediately; audio_file fills the disk cache in the background.
+    progressive_urls: TTLCache[tuple[str, dict[str, str]]] = TTLCache(120, maxsize=256)
+    progressive_pending: dict[str, asyncio.Task] = {}
+    progressive_slots = asyncio.Semaphore(2)
+    cache_pending: set[str] = set()
+
+    async def progressive_audio(source: str, source_id: str):
+        provider = service.manager.get(source)
+        resolve = getattr(provider, "progressive_audio", None)
+        if resolve is None or not re.fullmatch(r"[A-Za-z0-9_-]{11}", source_id):
+            return None
+        key = f"{source}:{source_id}"
+        cached = progressive_urls.get(key)
+        if cached is not None:
+            return cached
+
+        async def resolve_once():
+            try:
+                async with progressive_slots:
+                    result = await resolve(source_id)
+                if result is not None:
+                    progressive_urls.set(key, result)
+                return result
+            finally:
+                progressive_pending.pop(key, None)
+
+        if key not in progressive_pending:
+            if len(progressive_pending) >= 16:
+                return None
+            progressive_pending[key] = asyncio.create_task(resolve_once())
+        return await asyncio.shield(progressive_pending[key])
+
+    async def progressive_response(request: Request, source: str, source_id: str):
+        try:
+            resolved = await progressive_audio(source, source_id)
+        except Exception:
+            return None
+        if resolved is None:
+            return None
+        url, source_headers = resolved
+        headers = httpx.Headers(source_headers)
+        headers["accept-encoding"] = "identity"
+        byte_range = request.headers.get("range")
+        if request.method == "GET":
+            headers["range"] = byte_range or "bytes=0-"
+        client = httpx.AsyncClient(timeout=10.0, proxy=settings.ytdlp_proxy, follow_redirects=True)
+        try:
+            upstream = await client.send(client.build_request(request.method, url, headers=headers), stream=True)
+        except httpx.HTTPError:
+            await client.aclose()
+            return None
+        except BaseException:
+            await client.aclose()
+            raise
+        if upstream.status_code not in (200, 206, 416):
+            await upstream.aclose()
+            await client.aclose()
+            return None
+        status = upstream.status_code
+        if byte_range is None and status == 206:
+            status = 200
+        outgoing = {"cache-control": "no-store", "accept-ranges": "bytes"}
+        for name in ("content-length", "content-range"):
+            if name in upstream.headers:
+                outgoing[name] = upstream.headers[name]
+        if status == 200:
+            outgoing.pop("content-range", None)
+        if request.method == "HEAD" or status == 416:
+            await upstream.aclose()
+            await client.aclose()
+            if status == 416:
+                outgoing.pop("content-length", None)
+            return Response(status_code=status, headers=outgoing, media_type="audio/mp4")
+
+        async def chunks():
+            try:
+                async for chunk in upstream.aiter_raw(chunk_size=65536):
+                    yield chunk
+            finally:
+                await upstream.aclose()
+                await client.aclose()
+
+        return StreamingResponse(chunks(), status_code=status, headers=outgoing, media_type="audio/mp4")
+
+    def cache_audio_in_background(source: str, source_id: str) -> None:
+        key = f"{source}:{source_id}"
+        if key in cache_pending:
+            return
+        cache_pending.add(key)
+        task = asyncio.create_task(_preload_download(source, source_id))
+        task.add_done_callback(lambda _task: cache_pending.discard(key))
+        _bg_tasks.add(task)
+        task.add_done_callback(_bg_tasks.discard)
+        task.add_done_callback(lambda done: done.cancelled() or done.exception())
