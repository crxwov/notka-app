<Project Sdk="WixToolset.Sdk/6.0.0">
  <PropertyGroup>
    <InstallerPlatform>x64</InstallerPlatform>
    <Cultures>ru-RU</Cultures>
    <OutputName>Notka-Setup</OutputName>
    <ProductVersion Condition="'$(ProductVersion)' == ''">1.1.0</ProductVersion>
    <DefineConstants>$(DefineConstants);ProductVersion=$(ProductVersion);PublishDir=$(PublishDir);AssetsDir=$(AssetsDir)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="6.0.0" />
  </ItemGroup>
</Project>
