<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\notka.ico</ApplicationIcon>
    <AssemblyName>Notka</AssemblyName>
    <RootNamespace>Notka.Desktop</RootNamespace>
    <Version>1.1.0</Version>
    <Authors>crxwov, leksik</Authors>
    <Company>Notka</Company>
    <Product>Notka Music Player</Product>
    <Description>Lightweight desktop player for Notka on .NET 10 and WebView2 with native Windows SMTC and tray.</Description>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3124.44" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\notka.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\notka-512.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <EmbeddedResource Include="Bridge\notka-bridge.js" />
  </ItemGroup>

</Project>
